# Full-sheet MOD 40 renders and multi-engine OCR outputs are local,
# reproducible evidence caches.  The extraction script records source digest,
# engine versions, parameters, and artifact digests.
docs/evidence/ocr/mod40_98013_*/

# Source scans with unresolved redistribution terms stay in the local evidence
# cache. The tracked manifest records their origin and verified digest.
docs/evidence/local_sources/
