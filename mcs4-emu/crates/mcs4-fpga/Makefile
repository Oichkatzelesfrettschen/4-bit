# MCS-4 FPGA Synthesis Makefile
#
# WHY: Automates the synthesis, place-and-route, and bitstream generation
#      for MCS-4 chip designs targeting Lattice iCE40 and Xilinx Spartan-7.
# WHAT: Builds from behavioral Verilog (generated by mcs4-fpga crate) or
#       gate-level Verilog (generated by gate_to_verilog_v0.py).
# HOW: make ice40_synth CHIP=4001  (or CHIP=4002/4003/4004)
#      make xilinx_synth CHIP=4001

# ============================================================
# Configuration
# ============================================================

CHIP       ?= 4003
REPO_ROOT  := $(shell git rev-parse --show-toplevel 2>/dev/null || echo ../../..)
VERILOG_DIR := $(REPO_ROOT)/docs/evidence/verilog_v0
CONST_DIR  := constraints
BUILD_DIR  := build

# Source selection: "behavioral" uses mcs4-fpga generated Verilog,
# "gate" uses gate_to_verilog_v0.py output
MODE       ?= gate

ifeq ($(MODE),gate)
  TOP     := i$(CHIP)_gates
  VERILOG := $(VERILOG_DIR)/$(CHIP)/$(TOP).v
else
  TOP     := i$(CHIP)
  VERILOG := $(BUILD_DIR)/$(TOP).v
endif

PCF := $(CONST_DIR)/mcs4_ice40.pcf
XDC := $(CONST_DIR)/mcs4_spartan7.xdc

# iCE40 device selection
ICE40_DEVICE  ?= hx4k
ICE40_PACKAGE ?= tq144

# Spartan-7 part
SPARTAN7_PART ?= xc7s15ftgb196-1

# ============================================================
# Build directory
# ============================================================

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# ============================================================
# Generate behavioral Verilog from Rust crate
# ============================================================

.PHONY: generate
generate: $(BUILD_DIR)
	@echo "Generating behavioral Verilog from mcs4-fpga crate..."
	cargo test -p mcs4-fpga -- --ignored generate_verilog 2>/dev/null || \
	  echo "Note: Verilog generation via test harness not yet implemented"

# ============================================================
# iCE40 Targets (open-source toolchain: Yosys + nextpnr + icestorm)
# ============================================================

.PHONY: ice40_synth ice40_pnr ice40_bitstream ice40_prog ice40_all

ice40_synth: $(BUILD_DIR)
	@echo "=== Synthesizing $(TOP) for iCE40 ==="
	yosys -p "read_verilog $(VERILOG); \
	          synth_ice40 -top $(TOP) -json $(BUILD_DIR)/$(TOP)_synth.json" \
	      -l $(BUILD_DIR)/$(TOP)_synth.log
	@echo "Synthesis log: $(BUILD_DIR)/$(TOP)_synth.log"

ice40_pnr: ice40_synth
	@echo "=== Place-and-Route $(TOP) ==="
	nextpnr-ice40 --$(ICE40_DEVICE) --package $(ICE40_PACKAGE) \
	              --json $(BUILD_DIR)/$(TOP)_synth.json \
	              --pcf $(PCF) \
	              --asc $(BUILD_DIR)/$(TOP)_routed.asc \
	              --report $(BUILD_DIR)/$(TOP)_timing.json

ice40_bitstream: ice40_pnr
	@echo "=== Generating bitstream ==="
	icepack $(BUILD_DIR)/$(TOP)_routed.asc $(BUILD_DIR)/$(TOP).bin
	@echo "Bitstream: $(BUILD_DIR)/$(TOP).bin"

ice40_prog: ice40_bitstream
	iceprog $(BUILD_DIR)/$(TOP).bin

ice40_all: ice40_bitstream
	@echo "=== iCE40 build complete for $(TOP) ==="

# ============================================================
# Xilinx Spartan-7 Targets (Vivado)
# ============================================================

.PHONY: xilinx_synth xilinx_impl xilinx_bitstream

xilinx_synth: $(BUILD_DIR)
	@echo "=== Synthesizing $(TOP) for Spartan-7 ==="
	vivado -mode batch -nojournal -nolog -source /dev/stdin <<< '\
	  read_verilog $(VERILOG); \
	  read_xdc $(XDC); \
	  synth_design -top $(TOP) -part $(SPARTAN7_PART); \
	  write_checkpoint -force $(BUILD_DIR)/$(TOP)_post_synth.dcp; \
	  report_utilization -file $(BUILD_DIR)/$(TOP)_utilization.rpt'

xilinx_impl: xilinx_synth
	vivado -mode batch -nojournal -nolog -source /dev/stdin <<< '\
	  open_checkpoint $(BUILD_DIR)/$(TOP)_post_synth.dcp; \
	  opt_design; \
	  place_design; \
	  route_design; \
	  write_checkpoint -force $(BUILD_DIR)/$(TOP)_post_route.dcp; \
	  report_timing_summary -file $(BUILD_DIR)/$(TOP)_timing.rpt'

xilinx_bitstream: xilinx_impl
	vivado -mode batch -nojournal -nolog -source /dev/stdin <<< '\
	  open_checkpoint $(BUILD_DIR)/$(TOP)_post_route.dcp; \
	  write_bitstream -force $(BUILD_DIR)/$(TOP).bit'
	@echo "Bitstream: $(BUILD_DIR)/$(TOP).bit"

# ============================================================
# Simulation (iverilog + gtkwave)
# ============================================================

.PHONY: sim sim_view

sim: $(BUILD_DIR)
	@echo "=== Simulating $(TOP) ==="
	iverilog -o $(BUILD_DIR)/tb_$(TOP) \
	         $(VERILOG_DIR)/$(CHIP)/tb_$(TOP).v \
	         $(VERILOG)
	cd $(BUILD_DIR) && vvp tb_$(TOP)

sim_view: sim
	gtkwave $(BUILD_DIR)/tb_$(TOP).vcd

# ============================================================
# All chips
# ============================================================

.PHONY: all_ice40 all_sim

all_ice40:
	$(MAKE) ice40_synth CHIP=4003
	$(MAKE) ice40_synth CHIP=4002
	$(MAKE) ice40_synth CHIP=4001
	$(MAKE) ice40_synth CHIP=4004

all_sim:
	$(MAKE) sim CHIP=4003
	$(MAKE) sim CHIP=4002
	$(MAKE) sim CHIP=4001
	$(MAKE) sim CHIP=4004

# ============================================================
# Resource estimation (dry run)
# ============================================================

.PHONY: estimate

estimate: $(BUILD_DIR)
	@echo "=== Resource Estimation ==="
	@echo "Chip: $(CHIP)"
	@echo "Top module: $(TOP)"
	@echo "Source: $(VERILOG)"
	@wc -l $(VERILOG) 2>/dev/null && echo "lines of Verilog" || echo "Source not found"
	@echo ""
	@echo "Expected resource usage (iCE40HX4K has 3520 LUTs):"
	@echo "  4001 ROM:   ~200 LUTs"
	@echo "  4002 RAM:   ~100 LUTs"
	@echo "  4003 Shift: ~50 LUTs"
	@echo "  4004 CPU:   ~2000 LUTs (needs HX8K)"

# ============================================================
# Clean
# ============================================================

.PHONY: clean

clean:
	rm -rf $(BUILD_DIR)

.PHONY: help

help:
	@echo "MCS-4 FPGA Synthesis Makefile"
	@echo ""
	@echo "Usage: make <target> [CHIP=4001|4002|4003|4004] [MODE=gate|behavioral]"
	@echo ""
	@echo "Targets:"
	@echo "  ice40_synth    - Synthesize for iCE40 (Yosys)"
	@echo "  ice40_pnr      - Place and route (nextpnr)"
	@echo "  ice40_bitstream - Generate bitstream (icepack)"
	@echo "  ice40_prog     - Program FPGA (iceprog)"
	@echo "  ice40_all      - Full iCE40 build"
	@echo "  xilinx_synth   - Synthesize for Spartan-7 (Vivado)"
	@echo "  xilinx_impl    - Implement (place + route)"
	@echo "  xilinx_bitstream - Generate bitstream"
	@echo "  sim            - Simulate with iverilog"
	@echo "  sim_view       - Simulate and view waveforms"
	@echo "  all_ice40      - Synthesize all chips for iCE40"
	@echo "  all_sim        - Simulate all chips"
	@echo "  estimate       - Show resource estimates"
	@echo "  clean          - Remove build artifacts"
	@echo "  help           - Show this help"
