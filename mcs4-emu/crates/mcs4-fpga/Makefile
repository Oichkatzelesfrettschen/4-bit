# MCS-4 FPGA Synthesis Makefile
#
# WHY: Automates the synthesis, place-and-route, and bitstream generation
#      for MCS-4 chip designs targeting Lattice iCE40, Xilinx Spartan-7,
#      and Gowin GW1N-2 (KIWI FPGA board).
# WHAT: Builds from behavioral Verilog (generated by mcs4-fpga crate) or
#       gate-level Verilog (generated by gate_to_verilog_v0.py).
# HOW: make ice40_synth CHIP=4003 MODE=gate
#      make xilinx_synth CHIP=4003 MODE=gate
#      make gowin_synth  (MCS-4 system on GW1N-2)

# Recipes run under bash: the Vivado targets feed Tcl scripts through a
# <<< herestring, which POSIX sh does not support.
SHELL := /bin/bash

# ============================================================
# Configuration
# ============================================================

CHIP       ?= 4003
REPO_ROOT  := $(shell git rev-parse --show-toplevel 2>/dev/null || echo ../../..)
VERILOG_DIR := $(REPO_ROOT)/docs/evidence/verilog_v0
CONST_DIR  := constraints
BUILD_DIR  := build
GATE_CONTRACT_SCRIPT := $(REPO_ROOT)/scripts/gate_to_verilog_v0.py

# Source selection: "behavioral" uses mcs4-fpga generated Verilog,
# "gate" uses gate_to_verilog_v0.py output
MODE       ?= gate

ifeq ($(MODE),gate)
  TOP     := i$(CHIP)_gates
  VERILOG := $(VERILOG_DIR)/$(CHIP)/$(TOP).v
else
  TOP     := i$(CHIP)
  VERILOG := $(BUILD_DIR)/$(TOP).v
endif

# Gate exports are delivery inputs only when each declared output resolves
# through declared input anchors. The check rejects incomplete extraction
# artifacts before synthesis or simulation can present them as valid models.
ifeq ($(MODE),gate)
  GATE_CONTRACT_TARGET := gate_contract
endif

# PCF/XDC track TOP: gate mode synthesizes i$(CHIP)_gates from the
# extracted netlist, so its constraints are i$(CHIP)_gates_ice40.pcf /
# _spartan7.xdc (see constraints/README.md for the port<->pin provenance).
# Behavioral mode's TOP is i$(CHIP), for which no per-chip constraint file
# exists yet (mcs4-fpga generated Verilog has no fixed pinout). ice40_pnr
# reads PCF only at the pnr stage (ice40_synth itself does not); xilinx_synth
# reads XDC immediately via read_xdc, so xilinx_synth CHIP=<n> MODE=behavioral
# fails fast on a missing constraints/i<n>_spartan7.xdc rather than silently
# using the wrong pinout.
PCF := $(CONST_DIR)/$(TOP)_ice40.pcf
XDC := $(CONST_DIR)/$(TOP)_spartan7.xdc
CST := $(CONST_DIR)/mcs4_gowin.cst

# Gowin device (KIWI FPGA TINY 1P5 EVK, actual GW1N-2 LQFP100)
GOWIN_DEVICE := GW1N-LV2LQ100C6/I5
GW_SH        := /opt/gowin-eda-ide/bin/gw_sh
GW_SH_EDU    := /opt/gowin-eda-edu/IDE/bin/gw_sh
GOWIN_DIR    := gowin

# iCE40 device selection: HX8K-CT256 matches the ball names
# (B1/C1/D1/...) used in constraints/i<chip>_gates_ice40.pcf.
ICE40_DEVICE  ?= hx8k
ICE40_PACKAGE ?= ct256

# Spartan-7 part: xc7s25csga324 matches the PACKAGE_PIN names
# (M13/N13/P13/...) used in constraints/i<chip>_gates_spartan7.xdc.
SPARTAN7_PART ?= xc7s25csga324-1

# ============================================================
# Tool availability guards
# ============================================================
# Every target that invokes an external FPGA tool checks for the tool up
# front and fails with an install hint instead of a raw
# "command not found" shell error.

# require-tool: verify a tool is on PATH.
# $(1) = tool name, $(2) = install hint (no commas)
define require-tool
@command -v $(1) >/dev/null 2>&1 || { \
  echo "$(1) not found; install $(2)"; \
  exit 1; \
}
endef

# require-path: verify an executable exists at a fixed absolute path.
# $(1) = absolute path, $(2) = install hint (no commas)
define require-path
@test -x $(1) || { \
  echo "$(1) not found; install $(2)"; \
  exit 1; \
}
endef

# ============================================================
# Build directory
# ============================================================

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

.PHONY: gate_contract

gate_contract:
	@echo "=== Checking gate export contract for i$(CHIP)_gates ==="
	python3 $(GATE_CONTRACT_SCRIPT) --chips $(CHIP) \
	  --check-export-contract --check-generated

# ============================================================
# Generate behavioral Verilog from Rust crate
# ============================================================

.PHONY: generate
generate: $(BUILD_DIR)
	@echo "Generating behavioral Verilog from mcs4-fpga crate..."
	cargo run --locked -p mcs4-fpga --bin mcs4-fpga-export -- \
	  --chip $(CHIP) --flavor behavioral --output $(BUILD_DIR)/i$(CHIP).v

# ============================================================
# iCE40 Targets (open-source toolchain: Yosys + nextpnr + icestorm)
# ============================================================

.PHONY: ice40_synth ice40_pnr ice40_bitstream ice40_prog ice40_all

ice40_synth: $(GATE_CONTRACT_TARGET) $(BUILD_DIR)
	$(call require-tool,yosys,the OSS CAD Suite or the yosys package)
	@echo "=== Synthesizing $(TOP) for iCE40 ==="
	yosys -p "read_verilog $(VERILOG); \
	          synth_ice40 -top $(TOP) -json $(BUILD_DIR)/$(TOP)_synth.json" \
	      -l $(BUILD_DIR)/$(TOP)_synth.log
	@echo "Synthesis log: $(BUILD_DIR)/$(TOP)_synth.log"

ice40_pnr: ice40_synth
	$(call require-tool,nextpnr-ice40,the OSS CAD Suite or the nextpnr package)
	@echo "=== Place-and-Route $(TOP) ==="
	nextpnr-ice40 --$(ICE40_DEVICE) --package $(ICE40_PACKAGE) \
	              --json $(BUILD_DIR)/$(TOP)_synth.json \
	              --pcf $(PCF) \
	              --asc $(BUILD_DIR)/$(TOP)_routed.asc \
	              --report $(BUILD_DIR)/$(TOP)_timing.json

ice40_bitstream: ice40_pnr
	$(call require-tool,icepack,the icestorm tools)
	@echo "=== Generating bitstream ==="
	icepack $(BUILD_DIR)/$(TOP)_routed.asc $(BUILD_DIR)/$(TOP).bin
	@echo "Bitstream: $(BUILD_DIR)/$(TOP).bin"

ice40_prog: ice40_bitstream
	$(call require-tool,iceprog,the icestorm tools)
	iceprog $(BUILD_DIR)/$(TOP).bin

ice40_all: ice40_bitstream
	@echo "=== iCE40 build complete for $(TOP) ==="

# ============================================================
# Xilinx Spartan-7 Targets (Vivado)
# ============================================================

.PHONY: xilinx_synth xilinx_impl xilinx_bitstream

xilinx_synth: $(GATE_CONTRACT_TARGET) $(BUILD_DIR)
	$(call require-tool,vivado,Xilinx Vivado and add it to PATH)
	@echo "=== Synthesizing $(TOP) for Spartan-7 ==="
	vivado -mode batch -nojournal -nolog -source /dev/stdin <<< '\
	  read_verilog $(VERILOG); \
	  read_xdc $(XDC); \
	  synth_design -top $(TOP) -part $(SPARTAN7_PART); \
	  write_checkpoint -force $(BUILD_DIR)/$(TOP)_post_synth.dcp; \
	  report_utilization -file $(BUILD_DIR)/$(TOP)_utilization.rpt'

xilinx_impl: xilinx_synth
	$(call require-tool,vivado,Xilinx Vivado and add it to PATH)
	vivado -mode batch -nojournal -nolog -source /dev/stdin <<< '\
	  open_checkpoint $(BUILD_DIR)/$(TOP)_post_synth.dcp; \
	  opt_design; \
	  place_design; \
	  route_design; \
	  write_checkpoint -force $(BUILD_DIR)/$(TOP)_post_route.dcp; \
	  report_timing_summary -file $(BUILD_DIR)/$(TOP)_timing.rpt'

xilinx_bitstream: xilinx_impl
	$(call require-tool,vivado,Xilinx Vivado and add it to PATH)
	vivado -mode batch -nojournal -nolog -source /dev/stdin <<< '\
	  open_checkpoint $(BUILD_DIR)/$(TOP)_post_route.dcp; \
	  write_bitstream -force $(BUILD_DIR)/$(TOP).bit'
	@echo "Bitstream: $(BUILD_DIR)/$(TOP).bit"

# ============================================================
# Gowin GW1N-2 Targets (gw_sh + openFPGALoader)
# ============================================================
# WHY: Target the KIWI FPGA TINY 1P5 EVK for MCS-4 system.
# WHAT: Full MCS-4 system (i4004 + i4001 + i4002 + UART + clock).
# HOW:
#   make gowin_all   -- generate Verilog, synthesize, program FPGA
#   make gowin_tty   -- open serial terminal to board
#
# Single command deploy:
#   make gowin_all && make gowin_tty

GOWIN_SRCS := $(GOWIN_DIR)/mcs4_system_core.v \
              $(GOWIN_DIR)/mcs4_top.v \
              $(GOWIN_DIR)/mcs4_system_sim_top.v \
              $(GOWIN_DIR)/clock_gen.v \
              $(GOWIN_DIR)/uart_hw.v \
              $(GOWIN_DIR)/uart_bridge.v \
              $(GOWIN_DIR)/rom_bsram.v \
              $(GOWIN_DIR)/ram_bsram.v \
              $(BUILD_DIR)/i4004_fpga.v \
              $(BUILD_DIR)/i4001_fpga.v \
              $(BUILD_DIR)/i4002_fpga.v

GOWIN_SYNTHESIS_SRCS := $(GOWIN_DIR)/mcs4_system_core.v \
                        $(GOWIN_DIR)/mcs4_top.v \
                        $(GOWIN_DIR)/clock_gen.v \
                        $(GOWIN_DIR)/uart_hw.v \
                        $(GOWIN_DIR)/uart_bridge.v \
                        $(GOWIN_DIR)/rom_bsram.v \
                        $(GOWIN_DIR)/ram_bsram.v \
                        $(BUILD_DIR)/i4004_fpga.v \
                        $(BUILD_DIR)/i4001_fpga.v \
                        $(BUILD_DIR)/i4002_fpga.v

GOWIN_FS := impl/pnr/mcs4_system.fs
GOWIN_CLOCK_EVIDENCE ?=
GOWIN_CLOCK_VALIDATOR := $(REPO_ROOT)/scripts/verify_gowin_clock_contract.py
GOWIN_TIMING_CONSTRAINTS ?= $(BUILD_DIR)/mcs4_sys_clk.sdc
GOWIN_CLOCK_CONTRACT ?= $(BUILD_DIR)/gowin_clock_contract.json
GOWIN_SYNTHESIS_REPORT ?= impl/pnr/mcs4_system.rpt.txt
GOWIN_TIMING_PATHS ?= impl/pnr/mcs4_system.timing_paths
GOWIN_BUILD_EVIDENCE ?= $(BUILD_DIR)/gowin_build_evidence.json
GOWIN_DEPLOYMENT_BUILD ?= 0
GOWIN_CLOCK_STATIC_SRCS := $(filter-out $(BUILD_DIR)/%,$(GOWIN_SYNTHESIS_SRCS)) \
                           $(GOWIN_DIR)/mcs4_gowin.tcl \
                           $(GOWIN_DIR)/monitor_rom.hex
GOWIN_CLOCK_DEPLOYMENT_SRCS := $(GOWIN_SYNTHESIS_SRCS) \
                                $(GOWIN_DIR)/mcs4_gowin.tcl \
                                $(GOWIN_DIR)/monitor_rom.hex
GOWIN_CLOCK_STATIC_SOURCE_ARGS := $(foreach source,$(GOWIN_CLOCK_STATIC_SRCS),--source "$(source)")
GOWIN_CLOCK_DEPLOYMENT_SOURCE_ARGS := $(foreach source,$(GOWIN_CLOCK_DEPLOYMENT_SRCS),--source "$(source)")

# TTY device: GWU2U appears as /dev/ttyACM0 or /dev/ttyUSB0
GOWIN_TTY ?= $(shell ls /dev/ttyACM0 /dev/ttyUSB0 2>/dev/null | head -1)
GOWIN_BAUD ?= 115200

.PHONY: gowin_gen gowin_synth gowin_prog gowin_flash gowin_all gowin_clock_guard \
        gowin_source_guard gowin_program_guard \
        gowin_sim gowin_sim_view gowin_lint gowin_tty gowin_estimate

# Step 1: Generate FPGA chip Verilog from Rust crate
gowin_gen: $(BUILD_DIR)
	@echo "=== Generating FPGA Verilog from Rust ==="
	@for chip in 4004 4001 4002; do \
	  cargo run --locked -p mcs4-fpga --bin mcs4-fpga-export -- \
	    --chip $$chip --flavor fpga --output $(BUILD_DIR)/i$${chip}_fpga.v; \
	done

# Step 2: Synthesize + PnR + bitstream via gw_sh
gowin_synth: gowin_gen
	$(call require-path,$(GW_SH),the Gowin EDA IDE under /opt/gowin-eda-ide)
	@echo "=== Synthesizing MCS-4 system for GW1N-2 ==="
	@if [ "$(GOWIN_DEPLOYMENT_BUILD)" = "1" ]; then \
	  test -f "$(GOWIN_TIMING_CONSTRAINTS)" || { \
	    echo "deployment timing constraints do not exist: $(GOWIN_TIMING_CONSTRAINTS)"; \
	    exit 1; \
	  }; \
	  MCS4_GOWIN_SDC="$(abspath $(GOWIN_TIMING_CONSTRAINTS))" \
	    QT_QPA_PLATFORM=offscreen $(GW_SH) $(GOWIN_DIR)/mcs4_gowin.tcl; \
	else \
	  QT_QPA_PLATFORM=offscreen $(GW_SH) $(GOWIN_DIR)/mcs4_gowin.tcl; \
	fi
	@ls -lh $(GOWIN_FS) 2>/dev/null && echo "Synthesis artifact created; hardware deployment remains clock-gated" || \
	  echo "ERROR: Bitstream not produced"

gowin_clock_guard:
	@test -n "$(GOWIN_CLOCK_EVIDENCE)" || { \
	  echo "GOWIN_CLOCK_EVIDENCE must name a reviewed sys_clk_in board-route record"; \
	  exit 1; \
	}
	@test -f "$(GOWIN_CLOCK_EVIDENCE)" || { \
	  echo "clock evidence file does not exist: $(GOWIN_CLOCK_EVIDENCE)"; \
	  exit 1; \
	}
	@python3 $(GOWIN_CLOCK_VALIDATOR) --stage preflight \
	  --evidence "$(GOWIN_CLOCK_EVIDENCE)" --constraints "$(CST)" \
	  --expected-device "$(GOWIN_DEVICE)" --expected-top-module mcs4_top \
	  --timing-constraints "$(GOWIN_TIMING_CONSTRAINTS)" \
	  $(GOWIN_CLOCK_STATIC_SOURCE_ARGS)

gowin_source_guard:
	@test -n "$(GOWIN_CLOCK_EVIDENCE)" || { \
	  echo "GOWIN_CLOCK_EVIDENCE must name a reviewed sys_clk_in board-route record"; \
	  exit 1; \
	}
	@python3 $(GOWIN_CLOCK_VALIDATOR) --stage source \
	  --evidence "$(GOWIN_CLOCK_EVIDENCE)" --constraints "$(CST)" \
	  --expected-device "$(GOWIN_DEVICE)" --expected-top-module mcs4_top \
	  --timing-constraints "$(GOWIN_TIMING_CONSTRAINTS)" \
	  --contract "$(GOWIN_CLOCK_CONTRACT)" \
	  $(GOWIN_CLOCK_DEPLOYMENT_SOURCE_ARGS)

gowin_program_guard:
	@test -n "$(GOWIN_CLOCK_EVIDENCE)" || { \
	  echo "GOWIN_CLOCK_EVIDENCE must name a reviewed sys_clk_in board-route record"; \
	  exit 1; \
	}
	@python3 $(GOWIN_CLOCK_VALIDATOR) --stage programming \
	  --evidence "$(GOWIN_CLOCK_EVIDENCE)" --constraints "$(CST)" \
	  --expected-device "$(GOWIN_DEVICE)" --expected-top-module mcs4_top \
	  --timing-constraints "$(GOWIN_TIMING_CONSTRAINTS)" \
	  --contract "$(GOWIN_CLOCK_CONTRACT)" \
	  --synthesis-report "$(GOWIN_SYNTHESIS_REPORT)" \
	  --timing-paths "$(GOWIN_TIMING_PATHS)" --bitstream "$(GOWIN_FS)" \
	  --build-evidence "$(GOWIN_BUILD_EVIDENCE)" \
	  $(GOWIN_CLOCK_DEPLOYMENT_SOURCE_ARGS)

# Step 3: Program FPGA via GWU2X JTAG (volatile SRAM)
gowin_prog: gowin_clock_guard
	$(MAKE) gowin_gen
	$(MAKE) gowin_source_guard GOWIN_CLOCK_EVIDENCE="$(GOWIN_CLOCK_EVIDENCE)"
	$(MAKE) gowin_synth GOWIN_DEPLOYMENT_BUILD=1
	$(MAKE) gowin_program_guard GOWIN_CLOCK_EVIDENCE="$(GOWIN_CLOCK_EVIDENCE)"
	$(call require-tool,openFPGALoader,the openFPGALoader package)
	@echo "=== Programming GW1N-2 SRAM ==="
	openFPGALoader -c gwu2x $(GOWIN_FS)

# Program to Flash (persistent across power cycles)
gowin_flash: gowin_clock_guard
	$(MAKE) gowin_gen
	$(MAKE) gowin_source_guard GOWIN_CLOCK_EVIDENCE="$(GOWIN_CLOCK_EVIDENCE)"
	$(MAKE) gowin_synth GOWIN_DEPLOYMENT_BUILD=1
	$(MAKE) gowin_program_guard GOWIN_CLOCK_EVIDENCE="$(GOWIN_CLOCK_EVIDENCE)"
	$(call require-tool,openFPGALoader,the openFPGALoader package)
	@echo "=== Programming GW1N-2 Flash ==="
	openFPGALoader -c gwu2x -f $(GOWIN_FS)

# All-in-one: generate + synthesize + program (sequential)
gowin_all: gowin_prog

# Open serial terminal (Ctrl-A K to exit screen)
gowin_tty:
	@if [ -z "$(GOWIN_TTY)" ]; then \
	  echo "ERROR: No TTY device found. Is the GWU2U USB plugged in?"; \
	  exit 1; \
	fi
	@echo "=== Connecting to $(GOWIN_TTY) at $(GOWIN_BAUD) ==="
	@echo "    (Ctrl-A K to exit)"
	screen $(GOWIN_TTY) $(GOWIN_BAUD)

# Lint check (no license needed)
gowin_lint: gowin_gen
	$(call require-tool,verilator,the verilator package)
	@echo "=== Verilator lint ==="
	verilator --lint-only --Wall --top-module mcs4_top -DSIM $(GOWIN_SRCS)

# Simulate (no license needed)
gowin_sim: gowin_gen
	$(call require-tool,iverilog,the iverilog (Icarus Verilog) package)
	@echo "=== Simulating MCS-4 system ==="
	cp $(GOWIN_DIR)/monitor_rom.hex $(BUILD_DIR)/monitor_rom.hex
	iverilog -g2012 -Wall -Wno-timescale -s tb_mcs4_system -o $(BUILD_DIR)/tb_mcs4_system \
	  $(GOWIN_DIR)/tb_mcs4_system.v $(GOWIN_SRCS)
	cd $(BUILD_DIR) && vvp tb_mcs4_system

gowin_sim_view: gowin_sim
	$(call require-tool,gtkwave,the gtkwave package)
	gtkwave $(BUILD_DIR)/tb_mcs4_system.vcd

# Resource estimation via Education edition (no GW1N-2 license needed)
gowin_estimate: gowin_gen
	$(call require-path,$(GW_SH_EDU),the Gowin EDA Education edition under /opt/gowin-eda-edu)
	@echo "=== Resource estimation (GW1N-9C proxy) ==="
	QT_QPA_PLATFORM=offscreen $(GW_SH_EDU) $(GOWIN_DIR)/mcs4_estimate.tcl
	@echo ""; grep -A5 "Resource Usage" impl/pnr/mcs4_estimate.rpt.txt 2>/dev/null | head -10

# ============================================================
# Simulation (iverilog + gtkwave)
# ============================================================

.PHONY: sim sim_view

sim: $(GATE_CONTRACT_TARGET) $(BUILD_DIR)
	$(call require-tool,iverilog,the iverilog (Icarus Verilog) package)
	@echo "=== Simulating $(TOP) ==="
	iverilog -g2012 -Wall -o $(BUILD_DIR)/tb_$(TOP) \
	         $(VERILOG_DIR)/$(CHIP)/tb_$(TOP).v \
	         $(VERILOG)
	cd $(BUILD_DIR) && vvp tb_$(TOP)

sim_view: sim
	$(call require-tool,gtkwave,the gtkwave package)
	gtkwave $(BUILD_DIR)/tb_$(TOP).vcd

# ============================================================
# All chips
# ============================================================

.PHONY: all_ice40 all_sim

all_ice40:
	$(MAKE) ice40_synth CHIP=4003
	$(MAKE) ice40_synth CHIP=4002
	$(MAKE) ice40_synth CHIP=4001
	$(MAKE) ice40_synth CHIP=4004

all_sim:
	$(MAKE) sim CHIP=4003
	$(MAKE) sim CHIP=4002
	$(MAKE) sim CHIP=4001
	$(MAKE) sim CHIP=4004

# ============================================================
# Resource estimation (dry run)
# ============================================================

.PHONY: estimate

estimate: $(BUILD_DIR)
	@echo "=== Resource Estimation ==="
	@echo "Chip: $(CHIP)"
	@echo "Top module: $(TOP)"
	@echo "Source: $(VERILOG)"
	@wc -l $(VERILOG) 2>/dev/null && echo "lines of Verilog" || echo "Source not found"
	@echo ""
	@echo "Expected resource usage (iCE40HX4K has 3520 LUTs):"
	@echo "  4001 ROM:   ~200 LUTs"
	@echo "  4002 RAM:   ~100 LUTs"
	@echo "  4003 Shift: ~50 LUTs"
	@echo "  4004 CPU:   ~2000 LUTs (needs HX8K)"

# ============================================================
# Clean
# ============================================================

.PHONY: clean

clean:
	rm -rf $(BUILD_DIR)

.PHONY: help

help:
	@echo "MCS-4 FPGA Synthesis Makefile"
	@echo ""
	@echo "Usage: make <target> [CHIP=4001|4002|4003|4004] [MODE=gate|behavioral]"
	@echo ""
	@echo "Gowin GW1N-2 (KIWI board) targets:"
	@echo "  gowin_synth    - Synthesize MCS-4 system (gw_sh)"
	@echo "  gowin_prog     - Verify clock evidence, synthesize, then program SRAM"
	@echo "  gowin_flash    - Verify clock evidence, synthesize, then program Flash"
	@echo "  gowin_lint     - Verilator lint check"
	@echo "  gowin_sim      - Simulate system (iverilog)"
	@echo "  gowin_sim_view - Simulate and view waveforms"
	@echo ""
	@echo "iCE40 targets (individual chips):"
	@echo "  ice40_synth    - Synthesize for iCE40 (Yosys)"
	@echo "  ice40_pnr      - Place and route (nextpnr)"
	@echo "  ice40_bitstream - Generate bitstream (icepack)"
	@echo "  ice40_prog     - Program FPGA (iceprog)"
	@echo "  ice40_all      - Full iCE40 build"
	@echo ""
	@echo "Xilinx Spartan-7 targets:"
	@echo "  xilinx_synth   - Synthesize (Vivado)"
	@echo "  xilinx_impl    - Implement (place + route)"
	@echo "  xilinx_bitstream - Generate bitstream"
	@echo ""
	@echo "General:"
	@echo "  gate_contract  - Require a structurally resolved gate-HDL export"
	@echo "  sim            - Simulate individual chip with iverilog"
	@echo "  sim_view       - Simulate and view waveforms"
	@echo "  all_ice40      - Synthesize all chips for iCE40"
	@echo "  all_sim        - Simulate all chips"
	@echo "  estimate       - Show resource estimates"
	@echo "  clean          - Remove build artifacts"
	@echo "  help           - Show this help"
