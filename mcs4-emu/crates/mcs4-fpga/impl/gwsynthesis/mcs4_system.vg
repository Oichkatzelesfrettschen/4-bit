module rom_bsram (
  rom_addr,
  \gen_osch.ring ,
  rom_data
)
;
input [7:0] rom_addr;
input [4:4] \gen_osch.ring ;
output [7:0] rom_data;
wire [31:8] DO;
wire VCC;
wire GND;
  pROM mem_mem_0_0_s (
    .DO({DO[31:8],rom_data[7:0]}),
    .AD({GND,GND,GND,GND,rom_addr[6:0],GND,GND,GND}),
    .CLK(\gen_osch.ring [4]),
    .CE(VCC),
    .OCE(GND),
    .RESET(rom_addr[7]) 
);
defparam mem_mem_0_0_s.BIT_WIDTH=8;
defparam mem_mem_0_0_s.INIT_RAM_00=256'h0000404050202240503E224050342240502D22405053224050432240504D2221;
defparam mem_mem_0_0_s.INIT_RAM_02=256'h000000000000000000000000000000000000000000000000000000C0E1A2E1A3;
defparam mem_mem_0_0_s.READ_MODE=1'b0;
defparam mem_mem_0_0_s.RESET_MODE="SYNC";
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* rom_bsram */
