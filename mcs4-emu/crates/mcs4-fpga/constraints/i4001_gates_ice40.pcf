# i4001_gates Pin Constraints for Lattice iCE40 HX8K-CT256
#
# WHY: MODE=gate synthesizes TOP=i4001_gates from
#      docs/evidence/verilog_v0/4001/i4001_gates.v (gate-level extraction of
#      the 4001 mask ROM). Every port on that module header is constrained
#      here, and nothing else, so ice40_pnr cannot silently pass an
#      unconstrained or dangling port.
# WHAT: iCE40 HX8K-CT256 pin assignment for the i4001_gates top module.
# HOW:  nextpnr-ice40 --hx8k --package ct256 --pcf i4001_gates_ice40.pcf
#
# module i4001_gates (
#     input  wire VDD, VSS, D0_PAD, IO0,
#     output wire CL, CM, D2_PAD, D3_PAD
# );

# ============================================================
# Rail ports (structural model only; VDD/VSS are logic ports on
# this gate-level netlist, not the fabric's real supply rails --
# tie them to fixed-level pins pending board bring-up)
# ============================================================

set_io VDD B1
set_io VSS B2

# ============================================================
# Data I/O
# ============================================================

set_io D0_PAD C1
set_io IO0 C2
set_io CL D1
set_io CM D2
set_io D2_PAD F1
set_io D3_PAD E2
